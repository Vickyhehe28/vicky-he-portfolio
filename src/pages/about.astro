---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import PolaroidPortrait from '../components/PolaroidPortrait.astro';
import NoticedStrip from '../components/NoticedStrip.astro';
import site from '../data/site.json';

const skills = [
  'Art Direction', 'Brand Identity', 'Motion Graphics', 'Photography',
  'Publication Design', 'UI/UX Design', 'Video Editing', 'Visual Storytelling',
];
const tools = ['After Effects', 'Figma', 'Illustrator', 'InDesign', 'Photoshop', 'Premiere Pro', 'Claude Design', 'Midjourney'];
// Same glyphs and colours as the nav, in nav order
const lately = [
  { glyph: 'flower', color: 'green', verb: 'baking', text: 'salt bread, way too much of it' },
  { glyph: 'star', color: 'tomato', verb: 'raising', text: 'Wally, a very good dog' },
  { glyph: 'dot', color: 'cobalt', verb: 'noticing', text: 'light through windows' },
  { glyph: 'burst', color: 'pink', verb: 'planning', text: 'the next trip to Japan' },
] as const;
---
<Base title="About" current="about">
  <article class="about">
    <p class="eyebrow">( about )</p>

    <div class="intro">
      <p class="lead">Hi, I'm Vicky. I notice the little things people don't always see, but always feel.</p>
      <p class="body">
        As a visual designer and photographer, I design around them, letting each one help the bigger vision shine.
        Currently a grad student at USC's Iovine and Young Academy, exploring how design, business, and technology meet.
      </p>
    </div>

    <div class="info">
      <div class="col col--first">
        <section aria-labelledby="hi-h">
          <h2 id="hi-h" class="h">say hi</h2>
          <ul role="list">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
            <li>Based in Los Angeles</li>
          </ul>
          <p class="ps">p.s. tell me your favorite café</p>
        </section>

        <section class="lately" aria-labelledby="lately-h">
          <h2 id="lately-h" class="h">lately</h2>
          <ul role="list">
            {lately.map((l) => (
              <li><Glyph name={l.glyph} color={l.color} size="1em" class="lg" /><span>{l.verb} — {l.text}</span></li>
            ))}
          </ul>
        </section>
      </div>

      <section class="col" aria-labelledby="skills-h">
        <h2 id="skills-h" class="h">Skills</h2>
        <ul role="list">{skills.map((s) => <li>{s}</li>)}</ul>
      </section>

      <section class="col" aria-labelledby="tools-h">
        <h2 id="tools-h" class="h">Tools</h2>
        <ul role="list">{tools.map((s) => <li>{s}</li>)}</ul>
      </section>

      <div class="portrait"><PolaroidPortrait /></div>
    </div>

    <NoticedStrip />
  </article>
</Base>

<style>
  .about { padding: 56px var(--gutter) 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }

  /* Intro: big black headline, smaller grey body */
  .intro { display: grid; gap: 0.9em; }
  .lead { font: 400 clamp(20px, 2vw, 28px)/1.45 var(--display); letter-spacing: -0.01em; }
  .body { font: 400 clamp(14px, 1.4vw, 19.6px)/1.55 var(--display); color: #555; }

  .info { display: grid; grid-template-columns: 1fr; gap: 44px; margin-top: clamp(32px, 5vw, 64px); }
  .h { font: 400 clamp(17px, 1.4vw, 20px)/1.3 var(--display); letter-spacing: 0; margin-bottom: 22px; }
  .col ul { padding: 0; display: grid; gap: 12px; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.35; }
  .col li { white-space: nowrap; }
  .col a { color: inherit; text-underline-offset: 4px; }
  .col a:hover { color: var(--green-text); }

  .col--first { max-width: 280px; }
  .col--first li { white-space: normal; }
  .col--first ul { gap: 10px; }
  .ps { margin-top: 1.3em; font-size: clamp(13.5px, 1.1vw, 16px); color: #888; }
  .lately { margin-top: 30px; }
  .lately ul { font-size: clamp(13.5px, 1.1vw, 16px); gap: 8px; }
  .lately li { display: grid; grid-template-columns: auto 1fr; gap: 8px; align-items: baseline; }
  .lately :global(.lg) { transform: translateY(1px); }

  .portrait { --pw: clamp(240px, 25vw, 380px); justify-self: center; width: min(300px, 70vw); }

  :global(.noticed) { margin-top: clamp(48px, 7vw, 96px); }

  /* Phones: photo right under the intro, then contact, then Skills and Tools side by side */
  @media (max-width: 699px) {
    .info { grid-template-columns: 1fr 1fr; gap: 40px 20px; }
    .portrait { order: -1; grid-column: 1 / -1; width: min(280px, 72vw); }
    .col--first { grid-column: 1 / -1; max-width: none; }
    .col li { white-space: normal; }
  }
  @media (min-width: 700px) {
    .info { grid-template-columns: repeat(3, auto); justify-content: start; column-gap: 44px; }
    .portrait { grid-column: 1 / -1; justify-self: start; }
  }
  /* Desktop: columns and photo read as one group; photo top level with the headings */
  @media (min-width: 1024px) {
    .info { grid-template-columns: repeat(4, auto); justify-content: space-between; column-gap: 28px; align-items: start; }
    .portrait { grid-column: auto; justify-self: end; width: var(--pw); }
  }
</style>
