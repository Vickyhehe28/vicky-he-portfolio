---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoWall from '../../components/PhotoWall.astro';
import BlinkIntro from '../../components/BlinkIntro.astro';
import { seriesPhotos } from '../../lib/series';

export async function getStaticPaths() {
  const series = await getCollection('series', ({ data }) => data.featured && !data.wall);
  const sorted = series.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((s, i) => ({ params: { slug: s.id }, props: { s, prev: sorted[i - 1] } }));
}
const { s, prev } = Astro.props as { s: CollectionEntry<'series'>; prev?: CollectionEntry<'series'> };
const hero = s.data.layout !== 'wall' ? s.data.hero : undefined;
const plainHero = hero && s.data.heroStyle === 'plain';
const allPhotos = seriesPhotos(s);
const film = s.data.layout === 'sequence' ? s.data.film : undefined;
const paragraphs = (s.data.intro ?? '').split(/\n\s*\n/).filter(Boolean);
const showcase = (s.data.showcase ?? []).map((p) => ({ ...p, span: 'half' as const, title: '', caption: '', series: s.id, seriesTitle: s.data.title }));
const coverHero = hero && s.data.heroStyle === 'cover';
---
<Base title={s.data.title} current="photography">
  {s.data.opening === 'blink' && <BlinkIntro />}
  {plainHero ? (
    <>
      <!-- Full-width photo, title and intro below -->
      <header class="plain-hero">
        <img src={hero} alt={s.data.coverAlt} loading="eager" decoding="async" />
      </header>
      <div class="s-head s-head--after">
        <a class="back" href="/photography/#series">← ( photo series )</a>
        <h1 class="s-title">{s.data.title}</h1>
        {s.data.subtitle && <p class="s-sub">{s.data.subtitle}</p>}
        <div class="s-body">{paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>
    </>
  ) : coverHero ? (
    <>
      <!-- Whole cover centred, title and subtitle below -->
      <header class="cover">
        <a class="back" href="/photography/#series">← ( photo series )</a>
        <img src={hero} alt={s.data.coverAlt} loading="eager" decoding="async" />
        <h1 class="cover-title">{s.data.title}</h1>
        {s.data.intro && <p class="cover-sub">{s.data.intro}</p>}
      </header>
    </>
  ) : hero ? (
    <>
      <!-- Book series: big photo with the title over it -->
      <header class="hero">
        <img src={hero} alt="" loading="eager" decoding="async" />
        <a class="back back--light" href="/photography/#series">← ( photo series )</a>
        <h1 class="hero-title">{s.data.title}</h1>
      </header>
      <div class="s-head s-head--after">
        <p class="s-theme">{s.data.theme}</p>
        {s.data.intro && <p class="s-intro">{s.data.intro}</p>}
      </div>
    </>
  ) : (
    <header class="s-head">
      <a class="back" href="/photography/#series">← ( photo series )</a>
      <h1 class="s-title">{s.data.title}</h1>
      <p class="s-theme">{s.data.theme}</p>
      {s.data.intro && <p class="s-intro">{s.data.intro}</p>}
    </header>
  )}
  {film ? (
    <>
      <PhotoWall photos={allPhotos.slice(0, film.after)} series={[]} layout={s.data.layout} />
      <div class="film">
        <video src={film.src} autoplay muted loop playsinline preload="metadata" aria-label={`Short film from ${s.data.title}`}></video>
      </div>
      <PhotoWall photos={allPhotos.slice(film.after)} series={[]} layout={s.data.layout} />
    </>
  ) : (
    <PhotoWall photos={allPhotos} series={[]} layout={s.data.layout} />
  )}

  {showcase.length > 0 && (
    <section class="showcase" aria-labelledby="showcase-h">
      <h2 id="showcase-h" class="label">on display</h2>
      <PhotoWall photos={showcase} series={[]} layout="sequence" />
    </section>
  )}

  {(s.data.bts ?? []).length > 0 && (
    <section class="bts" aria-labelledby="bts-h">
      <h2 id="bts-h" class="label">behind the scenes</h2>
      <ul class="bts-grid" role="list">
        {(s.data.bts ?? []).map((b) => (
          <li>
            {b.video
              ? <video src={b.src} muted loop playsinline preload="metadata" aria-label={b.alt} data-autoplay></video>
              : <img src={b.src} alt={b.alt} loading="lazy" decoding="async" />}
          </li>
        ))}
      </ul>
    </section>
  )}

  {(s.data.credits ?? []).length > 0 && (
    <dl class="credits">
      {s.data.credits.map((c) => <div><dt>{c.role}</dt><dd>— {c.name}</dd></div>)}
    </dl>
  )}

  <nav class="series-nav" aria-label="Series">
    {prev ? <a href={`/photography/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
    <a href="/photography/#series">back to photography</a>
  </nav>
</Base>

<script>
  // Videos (the series film and behind-the-scenes clips) play muted on a loop while on screen
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
    }), { threshold: 0.25 });
    document.querySelectorAll<HTMLVideoElement>('.film video, video[data-autoplay]').forEach((v) => io.observe(v));
  }
</script>

<style>
  .s-head { padding: 56px var(--gutter) 32px; display: grid; gap: 12px; }
  .s-head--after { padding-top: 32px; }
  .back { font-size: 13px; letter-spacing: .03em; color: var(--grey); text-decoration: none; justify-self: start; }
  .back:hover { color: var(--ink); }
  .s-title { font: 400 clamp(32px, 4vw, 56px)/1.05 var(--display); letter-spacing: -0.02em; margin-top: 12px; }
  .s-theme { font-size: 12px; letter-spacing: .05em; text-transform: uppercase; color: var(--grey); }
  .s-intro { font: 400 clamp(18px, 1.6vw, 22px)/1.4 var(--display); max-width: 50ch; }

  .plain-hero { margin: 0; }
  .plain-hero img { display: block; width: 100%; height: min(86svh, 80vw); object-fit: cover; }
  .s-sub { font-size: 14px; color: #888; }
  .s-body { display: grid; gap: 1em; max-width: 60%; margin-top: 8px; font: 400 clamp(15px, 1.25vw, 18px)/1.6 var(--display); color: #555; }
  @media (max-width: 699px) { .s-body { max-width: none; } }

  .film { margin: clamp(32px, 5vw, 72px) var(--gutter); }
  .film video { display: block; width: 100%; height: auto; border-radius: var(--radius); background: #000; }

  .bts { margin-top: clamp(56px, 8vw, 104px); }
  .bts-grid { columns: 2; column-gap: 12px; padding: 0 var(--gutter); }
  @media (min-width: 1024px) { .bts-grid { columns: 3; } }
  .bts-grid li { break-inside: avoid; margin-bottom: 12px; }
  .bts-grid img, .bts-grid video { display: block; width: 100%; height: auto; border-radius: var(--radius); background: var(--soft); }

  .showcase { margin-top: clamp(56px, 8vw, 104px); }
  .label { padding: 0 var(--gutter); margin-bottom: 18px; font: 400 clamp(17px, 1.4vw, 20px)/1.3 var(--display); }
  .credits { margin: clamp(56px, 8vw, 104px) var(--gutter) 0; display: grid; gap: 6px; font-size: 14px; color: #888; }
  .credits div { display: flex; flex-wrap: wrap; gap: 0 6px; }
  .credits dd { margin: 0; }
  .series-nav { margin: 48px var(--gutter) 0; display: flex; justify-content: space-between; gap: 16px; font: 400 clamp(16px, 1.3vw, 19px)/1.3 var(--display); }
  .series-nav a { color: inherit; text-decoration: none; }
  .series-nav a:hover { text-decoration: underline; text-underline-offset: 4px; }

  .cover { min-height: calc(100svh - 60px); padding: 28px var(--gutter) 48px; display: grid; justify-items: center; align-content: center; gap: 14px; text-align: center; }
  .cover .back { justify-self: start; align-self: start; }
  .cover img { width: auto; max-width: min(100%, 520px); max-height: 66svh; margin-top: 12px; box-shadow: 0 18px 40px -26px rgba(0,0,0,.35); }
  .cover-title { margin-top: 18px; font: 400 clamp(32px, 4vw, 56px)/1.05 var(--display); letter-spacing: -0.02em; }
  .cover-sub { font-size: clamp(15px, 1.2vw, 17px); color: var(--grey); }
  @media (min-width: 1024px) { .cover { min-height: 100svh; } }

  .hero { position: relative; margin: 0; }
  .hero img { display: block; width: 100%; height: min(78svh, 62vw); object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0 0 auto; height: 40%; background: linear-gradient(rgba(0,0,0,.35), transparent); pointer-events: none; }
  .back--light { position: absolute; z-index: 1; top: 20px; left: var(--gutter); color: rgba(255,255,255,.85); }
  .back--light:hover { color: #fff; }
  .hero-title {
    position: absolute; z-index: 1; top: clamp(48px, 7vw, 88px); right: var(--gutter); margin: 0; color: #fff; text-align: right;
    font: 400 clamp(28px, 3.6vw, 52px)/1.05 var(--display); letter-spacing: -0.02em;
  }
</style>
