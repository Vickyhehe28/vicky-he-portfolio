---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Glyph from '../components/Glyph.astro';
import NavIndex from '../components/NavIndex.astro';
import RollingLogo from '../components/RollingLogo.astro';
import site from '../data/site.json';
import ogDefault from '../assets/og-default.jpg';

interface Props {
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
  current?: string;
}
const { title, description = site.description, ogImage = ogDefault, current } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/violet-sans/VioletSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#ffffff" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="shell">
    <!-- Desktop: fixed index on the left -->
    <aside class="side" aria-label="Site">
      <a class="logo" href="/" aria-label={`${site.name}, home`}>
        <RollingLogo />
      </a>
      <p class="who">
        <span class="sr-only">{site.role}</span>
        <!-- Cycles through site.roles, each word rolling up into place -->
        <span class="roles" aria-hidden="true" data-roles>{site.roles.map((r, i) => <span class:list={['r', { on: i === 0 }]} style={`color: var(--${r.color}-text)`}>{r.text}</span>)}</span>
      </p>

      <nav class="side-nav" aria-label="Main">
        <NavIndex current={current} />
      </nav>

      <div class="side-foot">
        <p class="small">© {year} {site.name}</p>
      </div>
    </aside>

    <!-- Mobile / tablet: top bar + full-screen menu -->
    <header class="top">
      <a class="logo" href="/" aria-label={`${site.name}, home`}>
        <RollingLogo />
      </a>
      <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" data-open-menu>menu</button>
    </header>
    <dialog id="menu" class="menu" aria-label="Menu">
      <div class="menu-top">
        <span class="logo" aria-hidden="true"><RollingLogo /></span>
        <button class="menu-btn" type="button" data-close-menu>close</button>
      </div>
      <nav aria-label="Main"><NavIndex current={current} size="lg" /></nav>
    </dialog>

    <main id="main" class="main">
      <slot />
      <footer class="foot">
        <p class="foot-line"><Glyph name="burst" color="pink" size="1em" /> say hi — <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <ul class="foot-links" role="list">
          <li><a href={site.linkedin} rel="me">linkedin</a></li>
        </ul>
      </footer>
    </main>
  </div>

  <script>
    // Sidebar role line: roll to the next word every 2.4s (stays on the first word if motion is reduced)
    const roles = [...document.querySelectorAll<HTMLElement>('[data-roles] .r')];
    if (roles.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let k = 0;
      setInterval(() => {
        const prev = roles[k];
        k = (k + 1) % roles.length;
        prev.classList.replace('on', 'out');
        roles[k].classList.remove('out');
        roles[k].classList.add('on');
        setTimeout(() => prev.classList.remove('out'), 600);
      }, 2400);
    }

    // Mobile menu
    const dlg = document.getElementById('menu') as HTMLDialogElement | null;
    document.querySelector('[data-open-menu]')?.addEventListener('click', () => dlg?.showModal());
    document.querySelector('[data-close-menu]')?.addEventListener('click', () => dlg?.close());
    dlg?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dlg.close()));

    // Soft scroll reveals
    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-in'));
    }
  </script>
</body>
</html>

<style>
  .shell { min-height: 100vh; }

  .logo {
    font: 500 26px/1 var(--display); letter-spacing: -0.05em; text-decoration: none;
    display: inline-flex; align-items: center;
  }
  .logo :global(.logo-g) { margin: 0 0.06em; transition: transform .6s var(--ease); }
  .logo:hover :global(.logo-g) { transform: rotate(180deg); }

  /* Sidebar: hidden on small screens */
  .side { display: none; }
  .top {
    position: sticky; top: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px var(--gutter);
    background: rgba(255,255,255,.92); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--ink);
  }
  .menu-btn {
    font: 500 14px/1 var(--body); background: none; color: var(--ink);
    border: 1px solid var(--ink); border-radius: 999px; padding: 9px 16px; cursor: pointer;
  }
  .menu-btn:hover { background: var(--ink); color: #fff; }

  .menu {
    width: 100%; max-width: none; height: 100%; max-height: none; margin: 0;
    border: 0; padding: 14px var(--gutter) 32px; background: var(--paper); color: var(--ink);
  }
  .menu[open] { display: flex; flex-direction: column; }
  .menu::backdrop { background: rgba(0,0,0,.2); }
  .menu-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18vh; }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] { animation: menuIn .35s var(--ease); }
    @keyframes menuIn { from { opacity: 0; transform: translateY(-8px); } }
  }

  .main { min-width: 0; }

  .foot {
    margin: 120px var(--gutter) 0; padding: 28px 0 40px; border-top: 1px solid var(--ink);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 15px;
  }
  .foot-line { display: inline-flex; align-items: center; gap: 8px; }
  .foot-links { display: flex; gap: 20px; }
  .foot a { text-underline-offset: 3px; }
  .foot a:hover { color: var(--pink-text); }

  @media (min-width: 1024px) {
    .shell { display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr); }
    .top, .menu { display: none !important; }
    .side {
      display: flex; flex-direction: column;
      position: sticky; top: 0; height: 100vh;
      padding: 28px 28px 24px;
      border-right: 1px solid var(--ink);
    }
    .side .logo { font-size: clamp(34px, 3vw, 46px); }
    .who { margin-top: 14px; font-size: 17px; line-height: 1.45; }
    .roles { display: inline-grid; overflow: hidden; vertical-align: bottom; font-weight: 500; }
    .r { grid-area: 1 / 1; opacity: 0; transform: translateY(100%); transition: transform .55s var(--ease), opacity .55s var(--ease); }
    .r.on { opacity: 1; transform: none; }
    .r.out { opacity: 0; transform: translateY(-100%); }
    @media (prefers-reduced-motion: reduce) { .r { transition: none; } }
    .side-nav { margin-top: auto; }
    .side-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 28px; }
    .small { font-size: 12px; color: var(--grey); text-transform: uppercase; letter-spacing: .03em; }
  }
</style>
