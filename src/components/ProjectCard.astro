---
import { Image } from 'astro:assets';
import Glyph from './Glyph.astro';
interface Props {
  href: string;
  title: string;
  tags: string[];
  image: ImageMetadata;
  video?: string;
  alt: string;
  glyph?: any;
  color?: any;
  priority?: boolean;
}
const { href, title, tags, image, video, alt, glyph = 'star', color = 'tomato', priority = false } = Astro.props;
---
<a class="card reveal" href={href}>
  <div class="media">
    {video ? (
      <video src={video} poster={image.src} aria-label={alt} autoplay muted loop playsinline preload="metadata" class="img"></video>
    ) : (
    <Image
      src={image}
      alt={alt}
      widths={[640, 1000, 1400, 2000]}
      sizes="(min-width: 1024px) 70vw, 100vw"
      loading={priority ? 'eager' : 'lazy'}
      quality={90}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      class="img"
    />
    )}
    <span class="shade" aria-hidden="true"></span>
    <span class="cg"><Glyph name={glyph} color={color} size="22px" /></span>
  </div>
  <div class="info">
    <h3 class="t">{title}</h3>
    <ul class="tags" role="list">
      {tags.map((t) => <li class="pill">{t}</li>)}
    </ul>
  </div>
</a>

<style>
  .card { display: block; position: relative; text-decoration: none; color: var(--ink); border-radius: var(--radius); }
  .media { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--soft); aspect-ratio: 16 / 10; }
  .img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .shade {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.62) 0%, rgba(0,0,0,.18) 45%, rgba(0,0,0,0) 70%);
    opacity: 0; transition: opacity .5s var(--ease);
  }
  .cg {
    position: absolute; top: 16px; right: 16px; display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%; background: #fff;
    opacity: 0; transform: scale(.6) rotate(-90deg);
    transition: opacity .45s var(--ease), transform .6s var(--ease);
  }

  /* Touch screens (no hover): title + tags sit under the image, always visible */
  .info { padding: 14px 2px 0; }
  .t { font: 500 22px/1.15 var(--display); letter-spacing: -0.02em; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; padding: 0; }
  .tags .pill { font-size: 11px; }

  /* Mouse / trackpad: info appears over the image on hover or keyboard focus */
  @media (hover: hover) and (pointer: fine) {
    .info {
      position: absolute; left: 0; right: 0; bottom: 0;
      padding: 22px; color: #fff;
      opacity: 0; transform: translateY(12px);
      transition: opacity .45s var(--ease), transform .55s var(--ease);
    }
    .t { font-size: clamp(22px, 2vw, 30px); }
    .tags .pill { border-color: rgba(255,255,255,.9); }
    .card:hover .info, .card:focus-visible .info { opacity: 1; transform: none; }
    .card:hover .shade, .card:focus-visible .shade { opacity: 1; }
    .card:hover .cg, .card:focus-visible .cg { opacity: 1; transform: none; }
    .card:hover .img, .card:focus-visible .img { transform: scale(1.035); }
  }
  @media (prefers-reduced-motion: reduce) {
    .img, .info, .cg { transition: none !important; }
  }
</style>

<script>
  // Make sure video thumbnails play (some browsers skip muted autoplay until in view)
  const vids = document.querySelectorAll<HTMLVideoElement>('.card video');
  if (vids.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
      });
    }, { threshold: 0.2 });
    vids.forEach((v) => io.observe(v));
  }
</script>
