---
/**
 * Auto-playing strip of 9:16 story images that glides sideways on a loop.
 * Hover (or focus) pauses it. Reduced-motion visitors get a still row.
 */
import { Image } from 'astro:assets';
interface Props { images: { image: ImageMetadata; alt: string }[]; label?: string; seconds?: number }
const { images, label = 'Social media stories', seconds = 6 } = Astro.props;
const dur = images.length * seconds;
---
<div class="stories" role="region" aria-label={label} tabindex="0" style={`--dur:${dur}s`}>
  <ul class="track" role="list">
    {[0, 1].map((copy) => images.map((s) => (
      <li class="story" aria-hidden={copy === 1 ? 'true' : undefined}>
        <Image src={s.image} alt={copy === 1 ? '' : s.alt} widths={[375, 750]} sizes="190px" quality={90} loading="eager" />
      </li>
    )))}
  </ul>
</div>

<style>
  .stories {
    grid-column: 1 / -1; overflow: hidden; padding: 28px 0; border-radius: var(--radius);
    background: var(--soft);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track { display: flex; gap: 16px; width: max-content; padding: 0; }
  .story { flex: none; height: clamp(260px, 30vw, 380px); aspect-ratio: 375 / 812; }
  .story :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 16px; box-shadow: 0 14px 30px -18px rgba(0,0,0,.45); }
  @media (prefers-reduced-motion: no-preference) {
    .track { animation: glide var(--dur) linear infinite; }
    .stories:hover .track, .stories:focus-within .track, .stories:focus .track { animation-play-state: paused; }
    @keyframes glide { to { transform: translateX(calc(-50% - 8px)); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { flex-wrap: wrap; justify-content: center; width: 100%; }
    .story[aria-hidden='true'] { display: none; }
  }
</style>
